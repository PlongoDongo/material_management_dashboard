# --- Neo4j -----------------------------------------------------------------
# Pflicht: ohne NEO4J_URI melden alle Datenprodukte, die den Graphen brauchen,
# einen Konfigurationsfehler, und /readyz meldet 503.
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/passwort
NEO4J_DB=neo4j

# --- Postgres --------------------------------------------------------------
# Async-Treiber ist Pflicht: postgresql+asyncpg://...
POSTGRES_DSN=postgresql+asyncpg://user:passwort@localhost:5432/analytics

# --- API -------------------------------------------------------------------
# dev | staging | prod
API_ENV=dev

# Kommagetrennt. Die Ports, auf denen die Dash-Apps laufen.
API_CORS_ORIGINS=http://localhost:8050,http://localhost:8051

# Kommagetrennt. LEER = Authentifizierung aus (nur fuer die Entwicklung).
#
# ACHTUNG: Kommentare gehoeren in eigene Zeilen, nicht hinter den Wert.
# python-dotenv entfernt einen nachgestellten Kommentar nur, wenn davor ein
# Wert steht -- `API_KEYS=   # leer` wuerde den Kommentartext als Schluessel
# lesen und die Auth damit EINschalten statt sie auszuschalten.
API_KEYS=

API_LOG_LEVEL=INFO
