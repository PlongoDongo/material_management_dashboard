# Credentials for Neo4j and Postgres are NOT set here -- the platform mounts
# them as files on the pod (see core/config.py -- _CREDENTIAL_FILES lists the
# names). This file holds everything else, plus
# the per-field overrides you may want locally.

# --- Credentials -----------------------------------------------------------
# The DIRECTORY the platform mounts the credential files into. Only set this if
# your deployment uses a different path than the default (/etc/credentials).
# The file NAMES live in _CREDENTIAL_FILES in core/config.py.
CREDENTIALS_DIR=

# Locally there is usually no mounted file. Set the fields directly instead --
# environment variables take precedence over the file, so the same variables
# also work as a one-off override on a pod that HAS the file.
#
# NEO4J_HOST=localhost
# NEO4J_PORT=7687
# NEO4J_PROTOCOL=bolt
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
#
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_USERNAME=postgres
# SQL_PASSWORD=password
# SQL_DATABASE=analytics
# SQL_SSL=

NEO4J_DB=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=2.0

# --- Server ----------------------------------------------------------------
# dev | staging | prod
API_ENV=dev
SERVER_PORT=8000
# critical | error | warning | info | debug
SERVER_LOGLEVEL=info

# --- CORS ------------------------------------------------------------------
# Comma-separated. The ports the Dash apps run on. Empty = the middleware is not
# installed at all, which is correct while every caller is server-side.
CORS_ORIGINS=http://localhost:8050,http://localhost:8051
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PATCH,PUT,DELETE
CORS_ALLOW_HEADERS=*

# --- OIDC / Keycloak -------------------------------------------------------
# EMPTY OIDC_ISSUER = authentication disabled (development only). With
# API_ENV=prod the app refuses to start in that state.
#
# NOTE: comments belong on their own line, not after the value. python-dotenv
# only strips a trailing comment when a value precedes it -- `OIDC_ISSUER=  # off`
# would read the comment text as an issuer and switch auth ON rather than off.
OIDC_ISSUER=

# The realm URL, e.g.
# OIDC_ISSUER=https://keycloak.example.com/realms/airbus

# The client id of THIS API. The token's `aud` must match, otherwise a token
# issued for another application would be accepted here.
OIDC_AUDIENCE=data-api

# Where client roles are read from (resource_access.<id>.roles). Usually the
# same as OIDC_AUDIENCE.
OIDC_CLIENT_ID=data-api

# Only relevant with API_ENV=prod: allows starting WITHOUT authentication, for a
# deployment on a closed network where every caller is trusted. Everything else
# (dev, staging) is open anyway when OIDC_ISSUER is empty.
#
# It does not weaken any check -- it exists so that "we decided against auth"
# and "somebody forgot OIDC_ISSUER" do not look identical. Every start then logs
# a warning saying the API is open.
ALLOW_ANONYMOUS=false
