# --- Neo4j -----------------------------------------------------------------
# Required: without NEO4J_URI every data product that needs the graph reports a
# configuration error, and /readyz answers 503.
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/password
NEO4J_DB=neo4j

# --- Postgres --------------------------------------------------------------
# The async driver is mandatory: postgresql+asyncpg://...
POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/analytics

# --- API -------------------------------------------------------------------
# dev | staging | prod
API_ENV=dev

# Comma-separated. The ports the Dash apps run on.
API_CORS_ORIGINS=http://localhost:8050,http://localhost:8051

# Comma-separated. EMPTY = authentication disabled (development only).
#
# NOTE: comments belong on their own line, not after the value. python-dotenv
# only strips a trailing comment when a value precedes it -- `API_KEYS=  # empty`
# would read the comment text as a key and switch auth ON rather than off.
API_KEYS=

API_LOG_LEVEL=INFO
