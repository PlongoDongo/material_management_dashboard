# Adresse des API-Layers. Das Dashboard spricht ausschliesslich hierueber --
# es hat keine Datenbankzugangsdaten mehr.
DATA_API_URL=http://localhost:8000

# --- Keycloak ---------------------------------------------------------------
# LEER = Anmeldung aus (nur Entwicklung). Ist der Issuer gesetzt, muss sich
# jeder Nutzer anmelden, und sein Token wird an die API weitergereicht.
KEYCLOAK_ISSUER=

# Beispiel:
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/airbus

# Der Client, den dieses Dashboard in Keycloak hat (vertraulicher Client mit
# Secret, weil das Dashboard serverseitig laeuft).
KEYCLOAK_CLIENT_ID=material-dashboard
KEYCLOAK_CLIENT_SECRET=

# Client-ID der API. Wird als Scope mit angefragt, damit die `aud`-Claim des
# Tokens zur API passt -- sonst lehnt sie das sonst gueltige Token ab.
DATA_API_AUDIENCE=data-api

# Signiert das Session-Cookie. In Produktion PFLICHT und geheim: ohne festen
# Wert wird bei jedem Neustart ein zufaelliger genommen, und alle Nutzer sind
# abgemeldet -- bei mehreren Prozessen sogar bei jedem zweiten Klick.
FLASK_SECRET_KEY=

# Optional: wie lange ein geholter Datenstand im Dashboard-Prozess gilt (Sekunden).
DATA_CACHE_TTL=60
