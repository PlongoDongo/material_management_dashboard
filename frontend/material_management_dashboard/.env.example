# Adresse des API-Layers. Das Dashboard spricht ausschliesslich hierueber --
# es hat keine Datenbankzugangsdaten mehr.
DATA_API_URL=http://localhost:8000

# Optional: nur noetig, wenn die API mit API_KEYS gestartet wurde.
DATA_API_KEY=

# Optional: wie lange ein geholter Datenstand im Dashboard-Prozess gilt (Sekunden).
DATA_CACHE_TTL=60
